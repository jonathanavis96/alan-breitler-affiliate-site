---
/**
 * Google Analytics 4 (GA4) loader — skeleton component.
 *
 * Loads the gtag.js library and initialises GA4 only if the
 * PUBLIC_GA_MEASUREMENT_ID environment variable is set at build time.
 *
 * If the variable is empty / unset, this component renders NOTHING.
 * That is deliberate: it lets the site ship without analytics before
 * the client has provided the Measurement ID, and silently turns
 * tracking on the moment the variable is configured and the site
 * is rebuilt — no code changes required.
 *
 * ─────────────────────────────────────────────────────────────────────
 * HOW TO ENABLE (when the client provides the G-XXXXX ID):
 * ─────────────────────────────────────────────────────────────────────
 *
 *   Cloudflare Pages (production — primary path):
 *     Dashboard → Workers & Pages → [project] → Settings →
 *       Environment variables → "Production" tab → Add variable:
 *         Name:  PUBLIC_GA_MEASUREMENT_ID
 *         Value: G-XXXXXXXXXX            (real ID from the GA4 property)
 *       Then trigger a redeploy (any push to main will do, or use the
 *       "Retry deployment" button on the latest deployment).
 *
 *   GitHub Pages (legacy / fallback deploy):
 *     Edit `.github/workflows/deploy.yml` and add an `env:` block to the
 *     "Build Astro site" step:
 *         env:
 *           PUBLIC_GA_MEASUREMENT_ID: ${{ secrets.PUBLIC_GA_MEASUREMENT_ID }}
 *     Then add the secret under repo Settings → Secrets and variables →
 *     Actions → New repository secret with the same name.
 *
 *   Local development:
 *     Add to `.env.local` (which is gitignored):
 *         PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
 *     Restart the dev server.
 *
 * ─────────────────────────────────────────────────────────────────────
 * WHY THE PUBLIC_ PREFIX?
 * ─────────────────────────────────────────────────────────────────────
 *   Astro only exposes env vars to the browser when prefixed with PUBLIC_.
 *   The GA Measurement ID is a public identifier (it ships in every HTML
 *   response from GA-enabled sites worldwide), so this is the correct
 *   prefix. Never use PUBLIC_ for secrets such as API keys.
 *
 * ─────────────────────────────────────────────────────────────────────
 * VERIFYING IT'S WORKING (after enabling):
 * ─────────────────────────────────────────────────────────────────────
 *   1. Open the live site in a browser, open DevTools → Network tab,
 *      filter by "collect" — you should see requests to
 *      `https://www.google-analytics.com/g/collect?...`
 *   2. Or install the "Google Tag Assistant" Chrome extension and
 *      visit the site — it should report the tag is firing.
 *   3. In GA4 itself: Reports → Realtime should show 1 active user
 *      within ~30 seconds.
 *
 * ─────────────────────────────────────────────────────────────────────
 * FUTURE WORK (not in this skeleton):
 * ─────────────────────────────────────────────────────────────────────
 *   - Affiliate click tracking: fire a `gtag('event', 'affiliate_click',
 *     { tool: '...', destination: '...' })` event from the /go/[slug]
 *     redirect page (or, better, from a Cloudflare Pages Function that
 *     handles the redirect server-side and posts to GA's Measurement
 *     Protocol — more reliable than client-side because it bypasses
 *     ad-blockers and works for fast clickers who leave before JS runs).
 *   - Cookie consent: GA4 supports Consent Mode v2. If the client wants
 *     a cookie banner, integrate it BEFORE the gtag init below so that
 *     consent state is set before any pings fire. Cloudflare Zaraz has
 *     a built-in consent manager which is the easiest path.
 *   - Cross-domain measurement: if affiliate destinations get linked
 *     into the GA property as referrals, that's a separate config.
 */

// Read at build time. Falsy → render nothing.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// Defensive sanity check: a real GA4 ID always starts with "G-" followed
// by 10 alphanumeric chars. If someone pastes a Universal Analytics
// "UA-..." ID or a typo by mistake, we'd rather render nothing than
// silently send hits to a wrong/invalid property. The full GA4 format
// allows up to 11 chars after "G-" in some edge cases, so we accept 8-12.
const isValidGa4Id = typeof gaId === 'string' && /^G-[A-Z0-9]{8,12}$/i.test(gaId);
---

{isValidGa4Id && (
  <>
    {/* Google tag (gtag.js) — async load from Google's CDN */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId, {
        // Anonymise IP — small privacy win that costs nothing.
        anonymize_ip: true,
        // Disable Google Signals (cross-device tracking via signed-in
        // Google accounts). Turn back on if/when the client explicitly
        // asks for it AND has the consent banner in place.
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
    </script>
  </>
)}
