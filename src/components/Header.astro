---
import siteData from '../../data/site.json';
import { url } from '../lib/base';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 w-full z-50 glass-nav" role="banner">
  <div class="container-wide flex justify-between items-center py-3 sm:py-4">
    <!-- Logo & Menu Toggle -->
    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        class="lg:hidden flex items-center justify-center w-11 h-11 -ml-2 rounded-lg text-primary active:scale-95 duration-200 hover:bg-surface-alt/50 transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <span class="material-symbols-outlined text-2xl" id="menu-icon">menu</span>
      </button>
      <a href={url('/')} class="text-xl sm:text-2xl font-headline font-bold tracking-tight no-underline hover:opacity-70 transition-opacity rounded-lg px-1 -mx-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none">
        <span class="text-primary">{siteData.brandPrefix}</span><span class="text-text">{siteData.brandSuffix}</span>
      </a>
    </div>

    <!-- Desktop Navigation (lg+ only — 7 items need ≥1024px to fit) -->
    <nav class="hidden lg:flex gap-6 xl:gap-8" aria-label="Main navigation">
      {siteData.navigation.map((item) => {
        const href = url(item.href);
        return (
          <a
            href={href}
            class:list={[
              'label-text no-underline transition-colors whitespace-nowrap rounded px-1.5 py-1 -mx-1.5 -my-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none',
              currentPath === href || (href !== url('/') && currentPath.startsWith(href))
                ? 'text-secondary font-bold'
                : 'text-on-surface-variant hover:text-primary',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Search -->
    <div class="flex items-center">
      <button id="search-open" class="flex items-center justify-center w-11 h-11 -mr-2 rounded-lg text-primary active:scale-95 duration-200 hover:bg-surface-alt/50 transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none" aria-label="Search">
        <span class="material-symbols-outlined text-2xl">search</span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation (animated slide-down) -->
  <div
    class="lg:hidden overflow-hidden transition-[max-height] duration-300 ease-in-out bg-base/95 backdrop-blur-sm"
    id="mobile-menu"
    style="max-height: 0;"
  >
    <nav class="container-wide py-2 pb-4 flex flex-col" aria-label="Mobile navigation">
      {siteData.navigation.map((item) => {
        const href = url(item.href);
        return (
          <a
            href={href}
            class:list={[
              'mobile-nav-link no-underline py-3 px-3 rounded-lg transition-colors text-sm font-body font-medium tracking-wide focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none',
              currentPath === href || (href !== url('/') && currentPath.startsWith(href))
                ? 'text-secondary font-bold bg-primary-muted'
                : 'text-on-surface-variant hover:text-primary hover:bg-surface-alt/50',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-14 sm:h-16"></div>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const mobileLinks = menu?.querySelectorAll('.mobile-nav-link');

  function closeMenu() {
    if (menu) {
      menu.style.maxHeight = '0';
    }
    button?.setAttribute('aria-expanded', 'false');
    if (menuIcon) menuIcon.textContent = 'menu';
  }

  function openMenu() {
    if (menu) {
      menu.style.maxHeight = menu.scrollHeight + 'px';
    }
    button?.setAttribute('aria-expanded', 'true');
    if (menuIcon) menuIcon.textContent = 'close';
  }

  function isMenuOpen(): boolean {
    return menu?.style.maxHeight !== '0px' && menu?.style.maxHeight !== '0' && menu?.style.maxHeight !== '';
  }

  button?.addEventListener('click', () => {
    if (isMenuOpen()) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close menu when a nav link is clicked
  mobileLinks?.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu when clicking outside header
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    const header = button?.closest('header');
    if (isMenuOpen() && header && !header.contains(target)) {
      closeMenu();
    }
  });

  // Close menu on Escape key and return focus to toggle button
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen()) {
      closeMenu();
      button?.focus();
    }
  });

  // Close mobile menu on window resize past lg breakpoint (1024px)
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && isMenuOpen()) {
      closeMenu();
    }
  });
</script>
