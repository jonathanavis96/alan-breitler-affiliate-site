---
import productData from '../../data/products.json';
import siteData from '../../data/site.json';
import { url } from '../lib/base';

// Collect all unique page links from navigation + footer
const seenHrefs = new Set<string>();
const pageItems: { title: string; subtitle: string; href: string; type: string }[] = [];

for (const item of [...siteData.navigation, ...siteData.footer.links]) {
  if (!seenHrefs.has(item.href)) {
    seenHrefs.add(item.href);
    pageItems.push({
      title: item.label,
      subtitle: '',
      href: url(item.href),
      type: 'Page',
    });
  }
}

// Build search index at build time
const searchItems = [
  ...productData.products.map((p) => ({
    title: p.name,
    subtitle: `${p.brand} · ${p.categories.map((c: string) => c.replace(/-/g, ' ')).join(', ')}`,
    href: url(`/reviews/${p.slug}/`),
    type: 'Review',
  })),
  ...pageItems,
];
---

<div id="search-overlay" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Search">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-base/95 backdrop-blur-md" id="search-backdrop"></div>

  <!-- Search panel -->
  <div class="relative z-10 flex flex-col items-center pt-[10vh] sm:pt-[15vh] px-4 sm:px-6">
    <div class="w-full max-w-2xl">
      <div class="flex items-center gap-3 sm:gap-4 mb-4">
        <span class="material-symbols-outlined text-white/70">search</span>
        <input
          type="search"
          id="search-input"
          placeholder="Search AI tools, reviews..."
          class="w-full bg-transparent text-white text-xl sm:text-3xl md:text-4xl font-headline italic placeholder:text-white/50 focus:outline-none focus-visible:outline-none border-none"
          autocomplete="off"
          aria-label="Search AI tools and reviews"
        />
        <button id="search-close" class="flex items-center justify-center w-11 h-11 -mr-2 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-all active:scale-95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" aria-label="Close search">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="h-[1px] bg-white/20 mb-8"></div>

      <!-- Search results -->
      <div id="search-results" class="space-y-2 mb-8" role="region" aria-label="Search results" aria-live="polite"></div>

      <!-- Quick links (shown when no query) -->
      <div id="search-quicklinks" class="text-white/70">
        <p class="label-text mb-4">Quick links</p>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          <a href={url('/top-tools/')} class="label-text inline-flex items-center min-h-[44px] bg-white/10 px-4 py-2.5 rounded-lg hover:bg-white/20 transition-colors no-underline text-white/70 active:scale-95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none">Top Tools</a>
          <a href={url('/reviews/')} class="label-text inline-flex items-center min-h-[44px] bg-white/10 px-4 py-2.5 rounded-lg hover:bg-white/20 transition-colors no-underline text-white/70 active:scale-95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none">Reviews</a>
          <a href={url('/resources/')} class="label-text inline-flex items-center min-h-[44px] bg-white/10 px-4 py-2.5 rounded-lg hover:bg-white/20 transition-colors no-underline text-white/70 active:scale-95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none">Resources</a>
          <a href={url('/about/')} class="label-text inline-flex items-center min-h-[44px] bg-white/10 px-4 py-2.5 rounded-lg hover:bg-white/20 transition-colors no-underline text-white/70 active:scale-95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none">About Us</a>
        </div>
      </div>

      <!-- No results message -->
      <div id="search-empty" class="hidden text-white/60 text-center py-8">
        <span class="material-symbols-outlined text-4xl mb-4 block opacity-50">search_off</span>
        <p class="font-body">No results found. Try a different search term.</p>
      </div>
    </div>
  </div>
</div>

<!-- Search index data embedded for client-side search -->
<script is:inline define:vars={{ searchItems }}>
  window.__SEARCH_INDEX__ = searchItems;
</script>

<script>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input') as HTMLInputElement;
  const backdrop = document.getElementById('search-backdrop');
  const closeBtn = document.getElementById('search-close');
  const openBtn = document.getElementById('search-open');
  const resultsEl = document.getElementById('search-results');
  const quicklinksEl = document.getElementById('search-quicklinks');
  const emptyEl = document.getElementById('search-empty');

  const searchIndex = (window as any).__SEARCH_INDEX__ || [];

  let opener: HTMLElement | null = null;

  function trapFocus(e: KeyboardEvent) {
    if (e.key !== 'Tab' || !overlay) return;
    const focusable = overlay.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  function openSearch() {
    opener = document.activeElement as HTMLElement;
    overlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', trapFocus);
    setTimeout(() => input?.focus(), 100);
  }

  function closeSearch() {
    overlay?.classList.add('hidden');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', trapFocus);
    if (input) input.value = '';
    updateResults('');
    opener?.focus();
    opener = null;
  }

  function createResultLink(item: { title: string; subtitle: string; href: string; type: string }) {
    const a = document.createElement('a');
    a.href = item.href;
    a.className = 'flex items-center gap-4 px-4 py-4 min-h-[48px] rounded-lg hover:bg-white/10 transition-colors no-underline group active:bg-white/15 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none';

    const typeSpan = document.createElement('span');
    typeSpan.className = 'label-text text-secondary/70 w-20 flex-shrink-0';
    typeSpan.textContent = item.type;

    const contentDiv = document.createElement('div');
    contentDiv.className = 'flex-1 min-w-0';

    const titleP = document.createElement('p');
    titleP.className = 'text-white font-body truncate';
    titleP.textContent = item.title;

    const subtitleP = document.createElement('p');
    subtitleP.className = 'text-white/60 text-xs font-label truncate';
    subtitleP.textContent = item.subtitle;

    contentDiv.appendChild(titleP);
    contentDiv.appendChild(subtitleP);

    const arrowSpan = document.createElement('span');
    arrowSpan.className = 'material-symbols-outlined text-white/50 group-hover:text-secondary transition-colors';
    arrowSpan.textContent = 'arrow_forward';
    arrowSpan.setAttribute('aria-hidden', 'true');

    a.appendChild(typeSpan);
    a.appendChild(contentDiv);
    a.appendChild(arrowSpan);

    return a;
  }

  function updateResults(query: string) {
    if (!resultsEl || !quicklinksEl || !emptyEl) return;

    // Clear previous results
    resultsEl.replaceChildren();

    if (!query.trim()) {
      quicklinksEl.classList.remove('hidden');
      emptyEl.classList.add('hidden');
      return;
    }

    const q = query.toLowerCase();
    const matches = searchIndex.filter((item: any) =>
      item.title.toLowerCase().includes(q) ||
      item.subtitle.toLowerCase().includes(q)
    );

    quicklinksEl.classList.add('hidden');

    if (matches.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    matches.forEach((item: any) => {
      resultsEl.appendChild(createResultLink(item));
    });
  }

  openBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);
  backdrop?.addEventListener('click', closeSearch);
  input?.addEventListener('input', (e) => updateResults((e.target as HTMLInputElement).value));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay?.classList.contains('hidden')) {
      closeSearch();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      overlay?.classList.contains('hidden') ? openSearch() : closeSearch();
    }
  });
</script>
