---
import siteData from '../../data/site.json';
import { url } from '../lib/base';

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-surface border-t border-outline/30 pt-12 sm:pt-16 pb-24 lg:pb-8" role="contentinfo">
  <!-- Subtle grain overlay -->
  <div class="grain-overlay pointer-events-none absolute inset-0 z-0"></div>

  <div class="container-wide relative z-10">
    <!-- Top section: Newsletter + Nav columns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-8 sm:gap-10 md:gap-12 mb-10 md:mb-12">

      <!-- Newsletter Signup Placeholder -->
      <div class="sm:col-span-2 md:col-span-5">
        <p class="font-headline text-lg sm:text-xl font-bold tracking-tight text-text mb-2">
          Stay ahead of the curve
        </p>
        <p class="text-muted text-sm mb-5 max-w-sm">
          Get weekly AI tool picks, academic workflow tips, and exclusive reviews — straight to your inbox.
        </p>
        <form class="flex flex-col xs:flex-row gap-2" onsubmit="return false;" aria-label="Newsletter signup">
          <input
            type="email"
            placeholder="your@university.edu"
            class="flex-1 min-w-0 px-4 py-2.5 rounded-lg bg-surface-alt border border-outline text-text text-sm placeholder:text-muted-dim focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/40 transition-colors"
            aria-label="Email address"
            disabled
          />
          <button
            type="submit"
            class="px-5 py-2.5 rounded-lg bg-primary text-on-primary font-body text-sm font-semibold hover:bg-primary-hover transition-colors whitespace-nowrap cursor-not-allowed opacity-90"
            disabled
            title="Coming soon"
            aria-label="Subscribe to newsletter (coming soon)"
          >
            Subscribe
          </button>
        </form>
        <p class="text-muted-dim text-xs mt-2">No spam. Unsubscribe anytime. Coming soon.</p>
      </div>

      <!-- Nav Links -->
      <div class="md:col-span-3 md:col-start-7">
        <p class="font-headline text-sm font-semibold tracking-wide uppercase text-muted mb-3 sm:mb-4">Explore</p>
        <nav class="grid grid-cols-2 sm:grid-cols-1 gap-x-4 gap-y-2 sm:gap-2.5" aria-label="Footer explore navigation">
          {siteData.navigation.map((item) => (
            <a
              href={url(item.href)}
              class="text-sm text-muted hover:text-primary transition-colors no-underline rounded px-1 -mx-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Legal Links -->
      <div class="md:col-span-3">
        <p class="font-headline text-sm font-semibold tracking-wide uppercase text-muted mb-3 sm:mb-4">Legal</p>
        <nav class="grid grid-cols-2 sm:grid-cols-1 gap-x-4 gap-y-2 sm:gap-2.5" aria-label="Footer legal navigation">
          {siteData.footer.links.map((link) => (
            <a
              href={url(link.href)}
              class="text-sm text-muted hover:text-primary transition-colors no-underline rounded px-1 -mx-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-outline/40 mb-6 sm:mb-8"></div>

    <!-- Bottom bar: Brand + Copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4">
      <!-- Brand mark -->
      <a href={url('/')} class="font-headline text-2xl font-bold tracking-tight no-underline hover:opacity-80 transition-opacity rounded-lg px-1 -mx-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-base focus-visible:outline-none">
        <span class="text-primary">{siteData.brandPrefix}</span><span class="text-text">{siteData.brandSuffix}</span>
      </a>

      <!-- Copyright + tagline -->
      <p class="text-muted-dim text-xs text-center sm:text-right">
        &copy; {currentYear} {siteData.name}. All rights reserved.
        <span class="hidden sm:inline">&mdash;</span>
        <br class="sm:hidden" />
        <span class="text-muted">{siteData.tagline}</span>
      </p>
    </div>
  </div>
</footer>

<!-- Mobile Bottom Nav -->
<nav class="lg:hidden fixed bottom-0 left-0 w-full flex justify-around items-center px-2 sm:px-4 mobile-nav-padding bg-base/80 backdrop-blur-xl shadow-[0_-4px_20px_rgba(0,0,0,0.3)] z-50 border-t border-outline/20" aria-label="Mobile navigation">
  <a href={url('/')} class="flex flex-col items-center justify-center text-primary pt-2 active:scale-90 transition-transform no-underline mobile-nav-item rounded-lg focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" aria-label="Home">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" /></svg>
    <span class="font-label text-[9px] sm:text-[10px] uppercase tracking-wider sm:tracking-widest font-bold">Home</span>
  </a>
  <a href={url('/top-tools/')} class="flex flex-col items-center justify-center text-muted hover:text-primary pt-2 active:scale-90 transition-transform no-underline mobile-nav-item rounded-lg focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" aria-label="Top Tools">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
    <span class="font-label text-[9px] sm:text-[10px] uppercase tracking-wider sm:tracking-widest font-bold">Tools</span>
  </a>
  <button type="button" id="mobile-search-trigger" class="flex flex-col items-center justify-center text-muted hover:text-primary pt-2 active:scale-90 transition-transform bg-transparent border-none cursor-pointer mobile-nav-item rounded-lg focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" aria-label="Open search">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    <span class="font-label text-[9px] sm:text-[10px] uppercase tracking-wider sm:tracking-widest font-bold text-current">Search</span>
  </button>
  <a href={url('/resources/')} class="flex flex-col items-center justify-center text-muted hover:text-primary pt-2 active:scale-90 transition-transform no-underline mobile-nav-item rounded-lg focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" aria-label="Guides and Resources">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
    <span class="font-label text-[9px] sm:text-[10px] uppercase tracking-wider sm:tracking-widest font-bold">Guides</span>
  </a>
</nav>

<style>
  /* Mobile bottom nav safe-area padding for notched devices */
  .mobile-nav-padding {
    padding-top: 0.5rem;
    padding-bottom: 1.25rem;
    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
  }

  /* Ensure nav items have consistent tap target sizes */
  .mobile-nav-item {
    min-width: 3rem;
    min-height: 2.75rem;
    padding-left: 0.25rem;
    padding-right: 0.25rem;
  }

  /* Extra small breakpoint for newsletter form (below 480px) */
  @media (max-width: 479px) {
    form[aria-label="Newsletter signup"] {
      flex-direction: column;
    }
  }
  @media (min-width: 480px) {
    form[aria-label="Newsletter signup"] {
      flex-direction: row;
    }
  }
</style>

<script>
  document.getElementById('mobile-search-trigger')?.addEventListener('click', () => {
    document.getElementById('search-open')?.click();
  });
</script>
