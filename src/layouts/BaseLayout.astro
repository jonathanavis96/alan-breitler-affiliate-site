---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import GradientOrbs from '../components/GradientOrbs.astro';
import siteData from '../../data/site.json';
import { url } from '../lib/base';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  canonicalUrl?: string;
  schema?: object;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = siteData.description,
  ogImage = url('/images/og-default.png'),
  ogImageAlt = `${siteData.name} — ${siteData.tagline}`,
  ogType = 'website',
  canonicalUrl,
  schema,
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = title === 'Home'
  ? `${siteData.name} - ${siteData.tagline}`
  : `${title} | ${siteData.name}`;

// Canonical URL: explicit prop preferred; fall back to Astro.url.href for pages
// that don't pass one. Suppressed entirely on noindex pages to avoid mixed signals.
const canonical = noindex ? undefined : (canonicalUrl || Astro.url.href);

/**
 * Resolve an image path to a fully qualified absolute URL.
 * Handles three cases:
 *   1. Already an absolute URL (https://...) — pass through
 *   2. Path with base prefix (/alan-breitler-affiliate-site/...) — resolve directly
 *   3. Path without base prefix (/images/...) — prepend base, then resolve
 */
function resolveAbsoluteUrl(path: string): string {
  if (path.startsWith('http')) return path;
  const base = import.meta.env.BASE_URL;
  const withBase = (base !== '/' && base !== '' && !path.startsWith(base))
    ? url(path)
    : path;
  return new URL(withBase, siteData.url).href;
}

const ogImageAbsolute = resolveAbsoluteUrl(ogImage);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content={siteData.colors.base} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={siteData.author.name} />
  {canonical && <link rel="canonical" href={canonical} />}

  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  }

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={siteData.name} />
  <meta property="og:locale" content="en_US" />

  {/* Article-specific OG tags */}
  {ogType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}
  {ogType === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  {siteData.social?.twitter && (
    <meta name="twitter:site" content={siteData.social.twitter} />
  )}
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

  <!-- Preconnect + dns-prefetch for Google Fonts CDN (Material Symbols) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

  <!-- Fonts: preload only the 3 critical weights used above the fold -->
  <link rel="preload" href={url('/fonts/space-grotesk/space-grotesk-700.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={url('/fonts/ibm-plex-sans/ibm-plex-sans-400.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={url('/fonts/ibm-plex-sans/ibm-plex-sans-700.woff2')} as="font" type="font/woff2" crossorigin />
  <style set:html={`
    @font-face { font-family: 'Space Grotesk'; src: url('${url('/fonts/space-grotesk/space-grotesk-400.woff2')}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Space Grotesk'; src: url('${url('/fonts/space-grotesk/space-grotesk-500.woff2')}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Space Grotesk'; src: url('${url('/fonts/space-grotesk/space-grotesk-600.woff2')}') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FFFD; }
    @font-face { font-family: 'Space Grotesk'; src: url('${url('/fonts/space-grotesk/space-grotesk-700.woff2')}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'IBM Plex Sans'; src: url('${url('/fonts/ibm-plex-sans/ibm-plex-sans-400.woff2')}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'IBM Plex Sans'; src: url('${url('/fonts/ibm-plex-sans/ibm-plex-sans-500.woff2')}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'IBM Plex Sans'; src: url('${url('/fonts/ibm-plex-sans/ibm-plex-sans-600.woff2')}') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'IBM Plex Sans'; src: url('${url('/fonts/ibm-plex-sans/ibm-plex-sans-700.woff2')}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  `} />

  <!-- Material Symbols (icons) — loaded async to prevent render-blocking -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" as="style" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </noscript>

  <!-- Schema markup -->
  {schema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body class="bg-background text-on-surface font-body">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:px-5 focus:py-2.5 focus:bg-primary focus:text-on-primary focus:rounded-lg focus:font-label focus:font-bold focus:text-sm focus:shadow-lg focus:shadow-primary/30 focus:no-underline focus:ring-2 focus:ring-primary/50 focus:ring-offset-2 focus:ring-offset-base focus:outline-none">Skip to main content</a>
  <Header />
  <SearchOverlay />
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Scroll-reveal: animate elements into view (supports all variants)
      const revealSelectors = '.scroll-reveal, .scroll-reveal-left, .scroll-reveal-right, .scroll-reveal-scale, .scroll-reveal-blur, .scroll-reveal-fade';
      const reveals = document.querySelectorAll(revealSelectors);
      if (reveals.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        );
        reveals.forEach((el) => observer.observe(el));
      }
    });
  </script>
  <main id="main-content" class="flex-1 relative">
    <!-- Page-level ambient gradient orbs -->
    <GradientOrbs variant="page" />
    <slot />
  </main>
  <Footer />
</body>
</html>
