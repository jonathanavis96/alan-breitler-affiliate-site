---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import GradientOrbs from '../../components/GradientOrbs.astro';
import siteData from '../../../data/site.json';
import libraryData from '../../../data/library.json';
import { url, canonicalUrl } from '../../lib/base';
import { librarySchema } from '../../lib/schema';

const books = libraryData.books;
const articles = libraryData.articles;
const bookCategories = libraryData.bookCategories;
const articleCategories = libraryData.articleCategories;

const pageUrl = canonicalUrl('/library/');
const schema = librarySchema(
  `AI Library - ${siteData.name}`,
  'Curated AI books and landmark research papers for academics — from foundational machine learning texts to cutting-edge studies shaping the field.',
  pageUrl,
  books,
  articles,
);

// Star icon builder. Returns one entry per star position with both the
// Material Symbols icon name and the FILL value (1 = filled, 0 = outline).
function starIcons(rating: number): { name: string; fill: 0 | 1 }[] {
  const out: { name: string; fill: 0 | 1 }[] = [];
  for (let i = 1; i <= 5; i++) {
    const full = i <= Math.floor(rating);
    const half = !full && (i - 0.5) <= rating;
    if (full) out.push({ name: 'star', fill: 1 });
    else if (half) out.push({ name: 'star_half', fill: 1 });
    else out.push({ name: 'star', fill: 0 });
  }
  return out;
}
---

<BaseLayout
  title="AI Library"
  description="Curated AI books and landmark research papers for academics — from foundational machine learning texts to cutting-edge studies shaping the field."
  canonicalUrl={pageUrl}
  schema={schema}
>
  <!-- Header -->
  <section class="container-wide py-12 sm:py-20 md:py-32 relative overflow-hidden" aria-label="AI Library collection">
    <GradientOrbs variant="section" />
    <div class="relative z-10">
      <span class="label-text text-primary font-bold mb-6 block">Curated Collection</span>
      <h1 class="font-headline font-bold text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-[0.9] tracking-tight max-w-3xl mb-6 sm:mb-8 text-text">
        AI <span class="text-primary">Library</span>
      </h1>
      <p class="text-muted text-lg max-w-xl leading-relaxed font-body mb-6">
        The essential reading list for academics working with AI. We've curated the books that shaped the field and the papers that define its frontier.
      </p>
      <p class="label-text text-muted-dim">{books.length} books · {articles.length} articles</p>
    </div>
  </section>

  <!-- Tab-style navigation -->
  <section class="container-wide pb-8">
    <nav class="flex flex-wrap gap-3" aria-label="Library sections">
      <a href="#books" class="inline-flex items-center gap-2 px-4 py-2 glass-panel text-sm font-label font-medium text-muted hover:text-primary hover:border-primary/30 transition-all duration-200 no-underline rounded-full">
        <span class="material-symbols-outlined text-sm" aria-hidden="true">menu_book</span>
        <span>Books</span>
        <span class="text-xs text-muted-dim">({books.length})</span>
      </a>
      <a href="#articles" class="inline-flex items-center gap-2 px-4 py-2 glass-panel text-sm font-label font-medium text-muted hover:text-primary hover:border-primary/30 transition-all duration-200 no-underline rounded-full">
        <span class="material-symbols-outlined text-sm" aria-hidden="true">article</span>
        <span>Articles & Papers</span>
        <span class="text-xs text-muted-dim">({articles.length})</span>
      </a>
    </nav>
  </section>

  <!-- Disclosure -->
  <section class="container-wide pb-8">
    <AffiliateDisclosure compact />
  </section>

  <!-- ═══════════════════════════════════════
       BOOKS SECTION (sort UI + click-to-expand)
       ═══════════════════════════════════════ -->
  <section id="books" class="py-16 md:py-24 bg-surface" aria-label="Recommended AI books">
    <div class="container-wide">
      <div class="flex items-center gap-3 mb-3">
        <span class="material-symbols-outlined text-3xl text-primary">menu_book</span>
        <h2 class="font-headline font-bold text-3xl md:text-4xl tracking-tight text-text">
          Books
        </h2>
      </div>
      <p class="text-muted text-lg mb-10 max-w-2xl font-body">
        Foundational texts, practical guides, and critical perspectives on artificial intelligence — each with our honest editorial take, current Amazon price, and star rating. Click any card to read the full review.
      </p>

      <!-- Sort controls -->
      <div class="mb-10 flex flex-wrap items-center gap-3" role="toolbar" aria-label="Sort books">
        <span class="label-text text-muted-dim mr-2">Sort by:</span>
        <button data-sort="category" class="sort-btn active inline-flex items-center gap-1.5 px-4 py-2 text-sm font-label font-medium rounded-full transition-all duration-200" aria-pressed="true">
          <span class="material-symbols-outlined text-sm" aria-hidden="true">category</span>
          <span>Category</span>
        </button>
        <button data-sort="price-asc" class="sort-btn inline-flex items-center gap-1.5 px-4 py-2 text-sm font-label font-medium rounded-full transition-all duration-200" aria-pressed="false">
          <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_upward</span>
          <span>Price (low to high)</span>
        </button>
        <button data-sort="price-desc" class="sort-btn inline-flex items-center gap-1.5 px-4 py-2 text-sm font-label font-medium rounded-full transition-all duration-200" aria-pressed="false">
          <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_downward</span>
          <span>Price (high to low)</span>
        </button>
        <button data-sort="rating" class="sort-btn inline-flex items-center gap-1.5 px-4 py-2 text-sm font-label font-medium rounded-full transition-all duration-200" aria-pressed="false">
          <span class="material-symbols-outlined text-sm" aria-hidden="true">star</span>
          <span>Highest rated</span>
        </button>
      </div>

      <!-- Category-grouped view (default) -->
      <div id="books-by-category" data-view="category">
        {bookCategories.map((category) => {
          const categoryBooks = books.filter(b => b.category === category);
          if (categoryBooks.length === 0) return null;
          return (
            <div class="mb-12">
              <h3 class="label-text text-primary font-bold mb-6">{category}</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {categoryBooks.map((book) => (
                  <article class="book-card glass-panel rounded-xl overflow-hidden transition-all duration-300" data-slug={book.slug} data-price={book.price} data-rating={book.rating}>
                    <!-- Clickable card header -->
                    <button
                      type="button"
                      class="book-card-toggle w-full text-left p-6 flex gap-5 group hover:bg-surface-alt/30 transition-all duration-200"
                      aria-expanded="false"
                      aria-controls={`expand-cat-${book.slug}`}
                    >
                      <div class="w-20 h-28 flex-shrink-0 bg-surface-alt rounded-lg overflow-hidden">
                        <img
                          src={url(book.image)}
                          alt={`${book.title} book cover`}
                          width="80"
                          height="112"
                          loading="lazy"
                          decoding="async"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        />
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2 mb-1">
                          <h4 class="font-headline font-bold text-text text-sm leading-snug group-hover:text-primary transition-colors line-clamp-2">{book.title}</h4>
                          {book.badge && (
                            <span class="badge-editorial text-[10px] shrink-0">{book.badge}</span>
                          )}
                        </div>
                        <p class="text-xs text-muted-dim mb-2">{book.author} · {book.year}</p>
                        <div class="flex items-center gap-3 mb-3 text-xs">
                          <span class="flex items-center gap-0.5 text-primary" aria-label={`Rated ${book.rating} out of 5`}>
                            {starIcons(book.rating).map((s) => (
                              <span class="material-symbols-outlined" style={`font-size:14px;font-variation-settings:'FILL' ${s.fill};`} aria-hidden="true">{s.name}</span>
                            ))}
                          </span>
                          <span class="text-muted-dim font-mono text-[11px]">{book.rating.toFixed(1)}</span>
                          <span class="text-muted-dim font-mono text-[11px]">·</span>
                          <span class="text-muted-dim font-mono text-[11px]">
                            {book.price > 0 ? `$${book.price.toFixed(2)}` : 'Free'}
                          </span>
                        </div>
                        <p class="text-sm text-muted leading-relaxed">{book.punchline}</p>
                        <div class="flex items-center gap-1 mt-3 text-xs font-label font-bold uppercase tracking-widest text-primary">
                          <span class="book-card-expand-label">Read review</span>
                          <span class="material-symbols-outlined text-sm transition-transform book-card-chevron" aria-hidden="true">expand_more</span>
                        </div>
                      </div>
                    </button>
                    <!-- Expanded panel -->
                    <div id={`expand-cat-${book.slug}`} class="book-card-panel hidden border-t border-white/5">
                      <div class="p-6 pt-5">
                        <p class="text-sm text-muted leading-relaxed mb-5">{book.review}</p>
                        <a
                          href={book.link}
                          target="_blank"
                          rel="nofollow sponsored noopener"
                          class="btn-primary no-underline inline-flex items-center gap-2 text-sm"
                        >
                          {book.price > 0 ? `Buy on Amazon · $${book.price.toFixed(2)}` : 'View free resource'}
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Flat sorted view (hidden by default; populated server-side, re-ordered client-side) -->
      <div id="books-flat" data-view="flat" class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="books-flat-grid">
          {books.map((book) => (
            <article class="book-card book-card-flat glass-panel rounded-xl overflow-hidden transition-all duration-300" data-slug={book.slug} data-price={book.price} data-rating={book.rating}>
              <button
                type="button"
                class="book-card-toggle w-full text-left p-6 flex gap-5 group hover:bg-surface-alt/30 transition-all duration-200"
                aria-expanded="false"
                aria-controls={`expand-flat-${book.slug}`}
              >
                <div class="w-20 h-28 flex-shrink-0 bg-surface-alt rounded-lg overflow-hidden">
                  <img
                    src={url(book.image)}
                    alt={`${book.title} book cover`}
                    width="80"
                    height="112"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <h4 class="font-headline font-bold text-text text-sm leading-snug group-hover:text-primary transition-colors line-clamp-2">{book.title}</h4>
                    {book.badge && (
                      <span class="badge-editorial text-[10px] shrink-0">{book.badge}</span>
                    )}
                  </div>
                  <p class="text-xs text-muted-dim mb-2">{book.author} · {book.year}</p>
                  <div class="flex items-center gap-3 mb-3 text-xs">
                    <span class="flex items-center gap-0.5 text-primary" aria-label={`Rated ${book.rating} out of 5`}>
                      {starIcons(book.rating).map((s) => (
                        <span class="material-symbols-outlined" style={`font-size:14px;font-variation-settings:'FILL' ${s.fill};`} aria-hidden="true">{s.name}</span>
                      ))}
                    </span>
                    <span class="text-muted-dim font-mono text-[11px]">{book.rating.toFixed(1)}</span>
                    <span class="text-muted-dim font-mono text-[11px]">·</span>
                    <span class="text-muted-dim font-mono text-[11px]">
                      {book.price > 0 ? `$${book.price.toFixed(2)}` : 'Free'}
                    </span>
                  </div>
                  <p class="text-sm text-muted leading-relaxed">{book.punchline}</p>
                  <div class="flex items-center gap-1 mt-3 text-xs font-label font-bold uppercase tracking-widest text-primary">
                    <span class="book-card-expand-label">Read review</span>
                    <span class="material-symbols-outlined text-sm transition-transform book-card-chevron" aria-hidden="true">expand_more</span>
                  </div>
                </div>
              </button>
              <div id={`expand-flat-${book.slug}`} class="book-card-panel hidden border-t border-white/5">
                <div class="p-6 pt-5">
                  <p class="text-sm text-muted leading-relaxed mb-5">{book.review}</p>
                  <a
                    href={book.link}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-primary no-underline inline-flex items-center gap-2 text-sm"
                  >
                    {book.price > 0 ? `Buy on Amazon · $${book.price.toFixed(2)}` : 'View free resource'}
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       ARTICLES & PAPERS SECTION
       ═══════════════════════════════════════ -->
  <section id="articles" class="py-16 md:py-24" aria-label="Landmark research articles and papers">
    <div class="container-wide">
      <div class="flex items-center gap-3 mb-3">
        <span class="material-symbols-outlined text-3xl text-accent">article</span>
        <h2 class="font-headline font-bold text-3xl md:text-4xl tracking-tight text-text">
          Articles & Papers
        </h2>
      </div>
      <p class="text-muted text-lg mb-10 max-w-2xl font-body">
        Landmark research papers and critical analyses that every AI researcher should know — from the Transformer paper to AI safety and ethics.
      </p>

      {articleCategories.map((category) => {
        const categoryArticles = articles.filter(a => a.category === category);
        if (categoryArticles.length === 0) return null;
        return (
          <div class="mb-12">
            <h3 class="label-text text-accent font-bold mb-6">{category}</h3>
            <div class="space-y-4">
              {categoryArticles.map((article, i) => (
                <a
                  href={article.link}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    'block glass-panel rounded-xl p-6 group no-underline transition-all duration-300',
                    'hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5',
                    `scroll-reveal scroll-delay-${i * 100}`,
                  ]}
                  aria-label={`${article.title} — ${article.authors} (opens in new tab)`}
                >
                  <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-start gap-3 mb-2">
                        <h4 class="font-headline font-bold text-text text-base leading-snug group-hover:text-accent transition-colors">{article.title}</h4>
                        {article.badge && (
                          <span class="badge-outlook text-[10px] shrink-0">{article.badge}</span>
                        )}
                      </div>
                      <p class="text-xs text-muted-dim mb-2">{article.authors} · {article.journal} · {article.year}</p>
                      <p class="text-sm text-muted leading-relaxed">{article.description}</p>
                    </div>
                    <div class="flex items-center gap-1 text-xs font-label font-bold uppercase tracking-widest text-accent shrink-0 sm:mt-1 opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                      Read paper
                      <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-24 bg-surface grain-overlay relative overflow-hidden">
    <GradientOrbs variant="section" />
    <div class="container-narrow text-center relative z-10">
      <h2 class="font-headline text-3xl md:text-4xl mb-4 text-text">Know a book or paper we should add?</h2>
      <p class="text-muted font-body mb-8 max-w-lg mx-auto">We're always expanding this collection. If there's a title that shaped your understanding of AI, we'd love to hear about it.</p>
      <a href={url('/contact/')} class="btn-primary no-underline inline-flex items-center gap-3">
        Suggest a Title
        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </section>

  <!-- Client-side sort + click-to-expand. Toggles classes and aria attributes only.
       Sort reorders existing DOM nodes (no innerHTML, no XSS surface). -->
  <script is:inline>
    (function () {
      const sortButtons = document.querySelectorAll('.sort-btn');
      const categoryView = document.getElementById('books-by-category');
      const flatView = document.getElementById('books-flat');
      const flatGrid = document.getElementById('books-flat-grid');
      if (!sortButtons.length || !categoryView || !flatView || !flatGrid) return;

      // ---------- Sort ----------
      const flatCards = Array.from(flatGrid.querySelectorAll('.book-card-flat'));

      function applySort(sortKey, pushState) {
        sortButtons.forEach(function (btn) {
          const active = btn.dataset.sort === sortKey;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        if (sortKey === 'category') {
          categoryView.classList.remove('hidden');
          flatView.classList.add('hidden');
        } else {
          const sorted = flatCards.slice();
          if (sortKey === 'price-asc') {
            sorted.sort(function (a, b) {
              const ap = parseFloat(a.dataset.price) || 0;
              const bp = parseFloat(b.dataset.price) || 0;
              return ap - bp || (parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating));
            });
          } else if (sortKey === 'price-desc') {
            sorted.sort(function (a, b) {
              const ap = parseFloat(a.dataset.price) || 0;
              const bp = parseFloat(b.dataset.price) || 0;
              return bp - ap || (parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating));
            });
          } else if (sortKey === 'rating') {
            sorted.sort(function (a, b) {
              const ar = parseFloat(a.dataset.rating) || 0;
              const br = parseFloat(b.dataset.rating) || 0;
              return br - ar || (parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
            });
          }
          sorted.forEach(function (card) { flatGrid.appendChild(card); });
          categoryView.classList.add('hidden');
          flatView.classList.remove('hidden');
        }

        if (pushState) {
          const u = new URL(window.location.href);
          if (sortKey === 'category') u.searchParams.delete('sort');
          else u.searchParams.set('sort', sortKey);
          history.replaceState(null, '', u.toString());
        }
      }

      sortButtons.forEach(function (btn) {
        btn.addEventListener('click', function (ev) {
          ev.preventDefault();
          applySort(btn.dataset.sort, true);
        });
      });

      const initial = new URL(window.location.href).searchParams.get('sort');
      const valid = ['category', 'price-asc', 'price-desc', 'rating'];
      if (initial && valid.indexOf(initial) >= 0) applySort(initial, false);

      // ---------- Click-to-expand ----------
      const toggles = document.querySelectorAll('.book-card-toggle');
      toggles.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const panelId = btn.getAttribute('aria-controls');
          const panel = panelId ? document.getElementById(panelId) : null;
          if (!panel) return;
          const isOpen = btn.getAttribute('aria-expanded') === 'true';
          const next = !isOpen;
          btn.setAttribute('aria-expanded', next ? 'true' : 'false');
          panel.classList.toggle('hidden', !next);
          const label = btn.querySelector('.book-card-expand-label');
          if (label) label.textContent = next ? 'Hide review' : 'Read review';
          const chev = btn.querySelector('.book-card-chevron');
          if (chev) chev.style.transform = next ? 'rotate(180deg)' : '';
        });
      });
    })();
  </script>

  <style>
    .sort-btn {
      color: var(--color-text-muted, #94a3b8);
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .sort-btn:hover {
      color: var(--color-primary, #6366f1);
      border-color: rgba(99, 102, 241, 0.3);
    }
    .sort-btn.active {
      color: var(--color-primary, #6366f1);
      background: rgba(99, 102, 241, 0.12);
      border-color: rgba(99, 102, 241, 0.4);
    }
    .book-card-toggle {
      background: transparent;
      border: 0;
      cursor: pointer;
    }
    .book-card-toggle:focus-visible {
      outline: 2px solid rgba(99, 102, 241, 0.5);
      outline-offset: -2px;
    }
    .book-card[data-slug]:has(.book-card-toggle[aria-expanded="true"]) {
      border-color: rgba(99, 102, 241, 0.3);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(99, 102, 241, 0.05);
    }
    .book-card-chevron {
      transition: transform 0.2s ease;
    }
    .book-card-panel {
      animation: book-card-fade-in 0.2s ease;
    }
    @keyframes book-card-fade-in {
      from { opacity: 0; transform: translateY(-4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</BaseLayout>
