---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GradientOrbs from '../../components/GradientOrbs.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import productData from '../../../data/products.json';
import siteData from '../../../data/site.json';
import { url, canonicalUrl } from '../../lib/base';
import { articleSchema } from '../../lib/schema';
import type { GetStaticPaths } from 'astro';

type ResourceEntry = CollectionEntry<'resources'>;

export const getStaticPaths: GetStaticPaths = async () => {
  const resources = await getCollection('resources', ({ data }) => !data.draft);
  return resources.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
};

const { entry } = Astro.props as { entry: ResourceEntry };
const { Content } = await render(entry);
const resource = entry.data;

// Resolve related product data for Tool Recommendations section
type Product = typeof productData.products[number];
const relatedProducts = (resource.relatedProducts ?? [])
  .map((slug: string) => productData.products.find((p) => p.slug === slug))
  .filter((p): p is Product => p !== undefined);

// Level badge styling
function levelColor(level: string): string {
  switch (level) {
    case 'beginner': return 'bg-success/10 text-success';
    case 'intermediate': return 'bg-accent/10 text-accent';
    case 'advanced': return 'bg-primary/10 text-primary';
    default: return 'bg-muted/10 text-muted';
  }
}

// Category labels for breadcrumb
const categoryLabels: Record<string, string> = {
  'getting-started': 'Getting Started',
  'prompt-engineering': 'Prompt Engineering',
  'workflow-guides': 'Workflow Guides',
  'tool-comparisons': 'Tool Comparisons',
};

// Per-resource takeaways keyed by slug
const takeawaysBySlug: Record<string, string[]> = {
  'getting-started-ai-research': [
    'Map your research workflow first — identify your biggest bottleneck before choosing a tool, so you invest time where it matters most.',
    'Start with one tool and one project. Incremental adoption beats wholesale overhaul every time.',
    'Build verification into your routine — never cite a paper based solely on an AI summary. Cross-reference against primary databases.',
    'Maintain a prompt library from day one. The prompts you refine over time become one of your most valuable research assets.',
  ],
  'prompt-engineering-literature-reviews': [
    'Define your research scope before writing a single prompt — specificity in your question produces specificity in your results.',
    'Use layered synthesis: descriptive, comparative, then critical. Each layer deepens your understanding of the literature.',
    'Gap-identification prompts are where the real value lies — use AI to find what is missing, not just what exists.',
    'Build and maintain a personal prompt library organised by task type. Effective prompts compound in value over time.',
  ],
};

const takeaways = takeawaysBySlug[resource.slug] ?? [
  'Start with clear goals — knowing exactly what you need from AI tools makes every subsequent step more effective.',
  'Practice iteratively — prompt engineering and tool mastery improve with consistent, deliberate experimentation.',
  'Always verify AI outputs — cross-reference results against primary sources and established databases in your field.',
];

// Schema.org structured data — Article schema with full @graph
const pageUrl = canonicalUrl(`/resources/${resource.slug}/`);
const schema = articleSchema(resource, pageUrl);

// OG image: use resource image if specified, else fall back to layout default
const ogImage = resource.image || undefined;
const ogImageAlt = resource.imageAlt || `${resource.title} — ${siteData.name} Guide`;
---

<BaseLayout
  title={resource.title}
  description={resource.description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  canonicalUrl={pageUrl}
  schema={schema}
  publishedTime={resource.publishDate.toISOString()}
  modifiedTime={resource.updatedDate?.toISOString()}
>
  <!-- ═══════════════════════════════════════
       Resource Header
       ═══════════════════════════════════════ -->
  <section class="relative py-12 sm:py-20 md:py-28 overflow-hidden">
    <!-- Decorative gradient blur orbs -->
    <GradientOrbs variant="section" />

    <div class="container-wide relative z-10">
      <!-- Breadcrumb -->
      <nav class="mb-8 animate-fade-in" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-muted-dim">
          <li><a href={url('/')} class="hover:text-primary transition-colors no-underline">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href={url('/resources/')} class="hover:text-primary transition-colors no-underline">Resources</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-muted truncate">{resource.title}</li>
        </ol>
      </nav>

      <div class="max-w-3xl animate-fade-in">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="badge-editorial">{categoryLabels[resource.category] ?? resource.category.replaceAll('-', ' ')}</span>
          <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${levelColor(resource.level)}`}>
            {resource.level}
          </span>
          <span class="label-text text-muted">{resource.readTime} min read</span>
        </div>

        <h1 class="font-headline font-bold text-2xl sm:text-3xl md:text-4xl lg:text-[3.25rem] leading-tight tracking-tight mb-6 text-text">
          {resource.title}
        </h1>

        <p class="text-muted text-base sm:text-lg leading-relaxed max-w-2xl mb-6">
          {resource.description}
        </p>

        <div class="flex flex-wrap items-center gap-4 text-sm text-muted-dim">
          <time datetime={resource.publishDate.toISOString().split('T')[0]}>
            Published {resource.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {resource.updatedDate && (
            <span>
              · Updated {resource.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       Section 1: Introduction
       ═══════════════════════════════════════ -->
  <section id="introduction" class="py-12 md:py-16 bg-surface scroll-reveal">
    <div class="container-narrow">
      <div class="glass-panel rounded-xl p-5 sm:p-8 md:p-10">
        <h2 class="font-headline font-bold text-xl sm:text-2xl md:text-3xl mb-6 flex items-center gap-3 text-text">
          <span class="text-primary material-symbols-outlined">menu_book</span> What You'll Learn
        </h2>
        <p class="text-base sm:text-lg text-muted leading-relaxed mb-6">
          {resource.description}
        </p>

        <!-- Quick info grid -->
        <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-6">
          <div class="bg-bg/50 rounded-lg p-3 sm:p-4 text-center">
            <span class="material-symbols-outlined text-primary text-xl sm:text-2xl mb-1 block">schedule</span>
            <span class="text-[10px] sm:text-xs text-muted-dim block">Read Time</span>
            <span class="text-xs sm:text-sm font-bold text-text">{resource.readTime} min</span>
          </div>
          <div class="bg-bg/50 rounded-lg p-3 sm:p-4 text-center">
            <span class="material-symbols-outlined text-accent text-xl sm:text-2xl mb-1 block">signal_cellular_alt</span>
            <span class="text-[10px] sm:text-xs text-muted-dim block">Level</span>
            <span class="text-xs sm:text-sm font-bold text-text capitalize">{resource.level}</span>
          </div>
          <div class="bg-bg/50 rounded-lg p-3 sm:p-4 text-center">
            <span class="material-symbols-outlined text-secondary text-xl sm:text-2xl mb-1 block">build</span>
            <span class="text-[10px] sm:text-xs text-muted-dim block">Tools</span>
            <span class="text-xs sm:text-sm font-bold text-text">{relatedProducts.length > 0 ? relatedProducts.length : '—'}</span>
          </div>
        </div>

        {relatedProducts.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 pt-4 border-t border-outline/20">
            <span class="text-xs text-muted-dim mr-1 shrink-0">Featured tools:</span>
            {relatedProducts.map((p) => (
              <a
                href={url(`/reviews/${p.slug}/`)}
                class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-bg/50 rounded-full text-[11px] sm:text-xs text-muted hover:text-primary transition-colors no-underline"
              >
                <span class="w-4 h-4 rounded bg-primary/10 flex items-center justify-center text-[10px] font-bold text-primary shrink-0">
                  {p.name.charAt(0)}
                </span>
                <span class="truncate max-w-[120px] sm:max-w-none">{p.name}</span>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Affiliate disclosure -->
      {relatedProducts.length > 0 && (
        <div class="mt-6">
          <AffiliateDisclosure />
        </div>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       Section 2: Step-by-step (MDX Content)
       ═══════════════════════════════════════ -->
  <section id="step-by-step" class="py-16 md:py-20 scroll-reveal">
    <div class="container-narrow">
      <h2 class="font-headline font-bold text-2xl md:text-3xl mb-8 flex items-center gap-3 text-text">
        <span class="text-accent">🔢</span> Step-by-step Guide
      </h2>

      <div class="prose-affiliate">
        <Content />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       Section 3: Tool Recommendations
       ═══════════════════════════════════════ -->
  <section id="tool-recommendations" class="py-16 md:py-20 bg-surface scroll-reveal">
    <div class="container-narrow">
      <h2 class="font-headline font-bold text-2xl md:text-3xl mb-4 flex items-center gap-3 text-text">
        <span class="text-primary material-symbols-outlined">build</span> Recommended Tools
      </h2>
      <p class="text-muted mb-8 leading-relaxed">Tools mentioned in this guide that we recommend for this workflow.</p>

      {relatedProducts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedProducts.map((product) => (
            <div class="card group hover:border-primary/30 transition-all duration-300">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                  <span class="text-primary text-xl font-headline font-bold">
                    {product.name.charAt(0)}
                  </span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="font-headline font-bold text-lg text-text">{product.name}</h3>
                    {product.badge && (
                      <span class="badge-editorial text-[10px] px-2 py-0.5">{product.badge}</span>
                    )}
                  </div>
                  <p class="text-sm text-muted-dim">{product.brand}</p>
                </div>
              </div>

              <!-- Score bar -->
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs text-muted shrink-0 w-24">Overall Score</span>
                <div class="flex-1 h-2 bg-bg rounded-full overflow-hidden">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-primary to-accent"
                    style={`width: ${(product.overallScore / 10) * 100}%`}
                  ></div>
                </div>
                <span class="text-sm font-bold font-headline text-accent">{product.overallScore}/10</span>
              </div>

              <p class="text-sm text-muted mb-4 leading-relaxed">{product.useCase}</p>

              <!-- Pros preview -->
              {product.pros && product.pros.length > 0 && (
                <ul class="text-xs text-muted-dim space-y-1 mb-4">
                  {product.pros.slice(0, 2).map((pro: string) => (
                    <li class="flex items-start gap-2">
                      <span class="text-success shrink-0 mt-0.5">+</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-3 pt-4 border-t border-outline/20">
                <span class="text-xs text-muted-dim">
                  {product.freeTier ? `Free tier · ${product.pricing}` : product.pricing}
                </span>
                <div class="flex items-center gap-3 shrink-0">
                  <a
                    href={url(`/reviews/${product.slug}/`)}
                    class="text-xs text-muted hover:text-primary font-medium no-underline transition-colors py-0.5"
                    aria-label={`Full review of ${product.name}`}
                  >
                    Full Review
                  </a>
                  <a
                    href={url(`/go/${product.affiliateSlug}/`)}
                    rel="nofollow sponsored noopener"
                    target="_blank"
                    class="text-xs text-primary hover:text-primary-hover font-bold no-underline transition-colors inline-flex items-center gap-1 py-0.5"
                    aria-label={`Try ${product.name} free (opens in new tab)`}
                  >
                    Try {product.name.split(' ')[0]}
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="glass-panel rounded-xl p-8 text-center">
          <p class="text-muted">
            Check our
            <a href={url('/top-tools/')} class="text-primary hover:text-primary-hover transition-colors">Top Tools</a>
            page for curated recommendations across all categories.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       Section 4: Key Takeaways
       ═══════════════════════════════════════ -->
  <section id="key-takeaways" class="py-16 md:py-20 scroll-reveal">
    <div class="container-narrow">
      <div class="relative grain-overlay rounded-xl overflow-hidden">
        <div class="bg-gradient-to-br from-primary/20 via-surface-alt to-accent/10 p-5 sm:p-8 md:p-12">
          <h2 class="font-headline font-bold text-xl sm:text-2xl md:text-3xl mb-6 sm:mb-8 flex items-center gap-3 text-text">
            <span class="text-accent material-symbols-outlined">lightbulb</span> Key Takeaways
          </h2>

          <div class="space-y-4">
            {takeaways.map((takeaway, i) => (
              <div class="flex items-start gap-3">
                <span class="text-accent mt-1 shrink-0 text-lg font-headline font-bold">{i + 1}.</span>
                <p class="text-text leading-relaxed">
                  {takeaway}
                </p>
              </div>
            ))}
            {relatedProducts.length > 0 && (
              <div class="flex items-start gap-3">
                <span class="text-accent mt-1 shrink-0 text-lg font-headline font-bold">{takeaways.length + 1}.</span>
                <p class="text-text leading-relaxed">
                  Explore the right tools — we recommend
                  {relatedProducts.map((p, i) => (
                    <>{i > 0 && (i === relatedProducts.length - 1 ? ' and ' : ', ')}
                    <a href={url(`/reviews/${p.slug}/`)} class="text-primary hover:text-primary-hover transition-colors">{p.name}</a></>
                  ))}
                  {' '}for this workflow.
                </p>
              </div>
            )}
          </div>

          <!-- CTA -->
          <div class="mt-8 pt-8 border-t border-outline/30 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a href={url('/top-tools/')} class="btn-primary no-underline inline-flex items-center justify-center gap-2">
              Browse All Tools
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href={url('/resources/')} class="btn-outline no-underline inline-flex items-center justify-center gap-2">
              More Resources
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Navigation (desktop sidebar) -->
  <nav class="hidden lg:block fixed right-6 top-1/2 -translate-y-1/2 z-40" aria-label="Resource sections">
    <div class="glass-panel rounded-lg p-2 space-y-1">
      <a href="#introduction" class="block px-3 py-1.5 text-xs text-muted hover:text-primary transition-colors rounded no-underline">Introduction</a>
      <a href="#step-by-step" class="block px-3 py-1.5 text-xs text-muted hover:text-primary transition-colors rounded no-underline">Step-by-step</a>
      <a href="#tool-recommendations" class="block px-3 py-1.5 text-xs text-muted hover:text-primary transition-colors rounded no-underline">Tool Recs</a>
      <a href="#key-takeaways" class="block px-3 py-1.5 text-xs text-muted hover:text-primary transition-colors rounded no-underline">Key Takeaways</a>
    </div>
  </nav>
</BaseLayout>
